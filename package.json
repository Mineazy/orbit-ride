{
  "name": "orbit-ride",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "vapid": "node scripts/generate-vapid-keys.mjs",
    "build:places": "node scripts/build-places.mjs",
    "dev:prod": "vite --mode local-backend",
    "build": "vite build",
    "build:command-center": "VITE_APP_ROLE=command-center vite build",
    "build:passenger": "VITE_APP_ROLE=passenger vite build",
    "build:driver": "VITE_APP_ROLE=driver vite build",
    "build:roads": "node scripts/build-road-graph.mjs",
    "build:apks": "node scripts/build-apks.js",
    "generate:ios": "node scripts/generate-ios.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test tests/unit/places.test.mjs tests/unit/route.test.mjs tests/unit/push.test.mjs tests/unit/tracking.test.mjs tests/unit/deploy.test.mjs",
    "test:db": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test tests/db/foundation.test.mjs tests/db/dispatch.test.mjs tests/db/wallet.test.mjs tests/db/hardening.test.mjs tests/db/signed-routes.test.mjs tests/db/push.test.mjs tests/db/local-backend.test.mjs"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/push-notifications": "^8.1.3",
    "@protomaps/basemaps": "^5.7.2",
    "@supabase/supabase-js": "^2.106.2",
    "lucide-react": "^1.17.0",
    "maplibre-gl": "^6.14.0",
    "pmtiles": "^4.5.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^10.0.1",
    "@mapbox/vector-tile": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "pbf": "^5.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.0.12"
  }
}
