# OrbitRide - Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file with real keys.

# ==========================================
# Supabase Credentials (Required)
# ==========================================
# Get these from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# For server-side operations only (never expose in client):
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ==========================================
# Server Configuration (Optional)
# ==========================================
PORT=5173
NODE_ENV=development

# ==========================================
# App Role (Optional - for standalone builds)
# ==========================================
# VITE_APP_ROLE=command-center  # Options: command-center, passenger, driver

# Optional: URL of a PMTiles archive (defaults to the bundled public/tiles/windhoek.pmtiles)
# VITE_PMTILES_URL=https://example.com/tiles/windhoek.pmtiles

# ==========================================
# Production mode (real accounts, rides through the server)
# ==========================================
# VITE_APP_MODE=production            # switches the apps from the offline demo to the production backend
# VITE_APP_ROLE=passenger             # passenger | driver | command-center (the admin app)
# For a local trial with no Supabase project: npm run dev:prod  (uses .env.local-backend, never deploy it)

# Shown on the Terms / Privacy / Refunds pages (set before launch, see docs/launch-checklist.md)
# Browser push notifications: the PUBLIC key from `npm run vapid` (see docs/push-notifications.md)
# VITE_VAPID_PUBLIC_KEY=

# VITE_COMPANY_NAME=
# VITE_COMPANY_ADDRESS=
# VITE_SUPPORT_EMAIL=
# VITE_SUPPORT_PHONE=
# VITE_LEGAL_UPDATED=
# VITE_LEGAL_REVIEWED=true            # only after a lawyer has reviewed src/prod/Legal.tsx
